# Supabase -> Authentication -> Users -> Add user (tick "Auto Confirm User").
HARU_ALLOWED_EMAIL=daehyuklee@gmail.com

# --- Anthropic (Plan chat, step 3 - not used yet) ---
ANTHROPIC_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
