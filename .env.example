# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for the Google Tasks / Calendar sync jobs later. Not needed for step 1.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Single-user gate ---
# The only identity allowed past the login screen. Supabase auth is email-keyed,
# but this can be a synthetic address so you log in with a plain username.
# Create the matching user in Supabase -> Authentication -> Users -> Add user
# (email = this value, set a password, tick "Auto Confirm User").
HARU_ALLOWED_EMAIL=dae@haru.local

# Login form appends this to a bare username: "dae" -> "dae@haru.local".
# Type a full address on the login screen to bypass it.
NEXT_PUBLIC_HARU_LOGIN_DOMAIN=haru.local

# --- Anthropic (Plan chat, step 3 - not used yet) ---
ANTHROPIC_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
